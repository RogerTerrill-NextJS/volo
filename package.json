{
  "name": "volo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs tests/*.test.mts",
    "test:cache:unit": "node --conditions=react-server --test tests/private-response.unit.mts",
    "test:cache:http": "node scripts/verify-private-cache.mjs",
    "test:cache": "npm run test:cache:unit && npm run test:cache:http",
    "test:boundaries": "node scripts/verify-supabase-boundaries.mjs",
    "test:auth:integration": "node scripts/verify-auth-integration.mjs",
    "test:clients": "node scripts/verify-supabase-clients.mjs",
    "test:proxy:unit": "node --conditions=react-server --test tests/supabase-proxy.unit.mts",
    "test:proxy": "npm run test:proxy:unit && node scripts/verify-supabase-proxy.mjs",
    "test:access:unit": "node --conditions=react-server --test tests/auth-transport.unit.mts tests/invitation-eligibility.unit.mts",
    "test:access": "npm run test:access:unit && node scripts/verify-server-access.mjs",
    "test:protected-app": "node scripts/verify-protected-app.mjs",
    "test:mutations:unit": "node --conditions=react-server --test tests/mutation-policy.unit.mts",
    "test:mutations:http": "node scripts/verify-mutations.mjs --actions",
    "test:mutations": "npm run test:mutations:unit && npm run test:mutations:http",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:types": "node scripts/database-types.mjs",
    "db:types:check": "node scripts/database-types.mjs --check",
    "test:invitations:unit": "node --conditions=react-server --test tests/invitation-send.unit.mts tests/invitation-resend.unit.mts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
