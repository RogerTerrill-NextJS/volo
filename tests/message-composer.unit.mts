import assert from 'node:assert/strict';
import {test} from 'node:test';
import {composerResult,type ComposerState} from '../lib/messages/composer-state.ts';
const thread='20900000-0000-4000-8000-000000000001',message='20900000-0000-4000-8000-000000000002',next='20900000-0000-4000-8000-000000000003',sender='20900000-0000-4000-8000-000000000004';
const initial:ComposerState={revision:0,status:'editing',messageId:message,body:'',notice:null};
const form=()=>{const f=new FormData();f.set('conversation_id',thread);f.set('message_id',message);f.set('body',"Pilot's note\r\n<script>text</script> 🛩");return f;};
const confirmation={code:'sent',id:message,conversationId:thread,senderId:sender,createdAt:'2026-10-24T12:00:00.123456Z'};
test('composer clears text and rotates identity only after exact confirmation',()=>{const state=composerResult(initial,form(),confirmation,next);assert.equal(state.status,'sent');assert.equal(state.messageId,next);assert.equal(state.body,'');assert.equal(state.notice,'Message sent.');assert.equal(state.revision,1);});
test('uncertain sends preserve exact normalized retry payload and identity',()=>{for(const result of [{code:'send_unconfirmed'},{code:'internal_error'},{code:'unavailable'},null,{...confirmation,id:next},{...confirmation,conversationId:next},{...confirmation,createdAt:'bad'}]){const state=composerResult(initial,form(),result,next);assert.equal(state.status,'unconfirmed');assert.equal(state.messageId,message);assert.equal(state.body,"Pilot's note\n<script>text</script> 🛩");assert.match(state.notice!,/same message/);}});
test('composer projects fixed denied/input feedback without provider text',()=>{for(const code of ['forbidden','unauthenticated','conversation_unavailable']){const state=composerResult(initial,form(),{code,message:'private-provider-canary'},next);assert.equal(state.status,'denied');assert.ok(!JSON.stringify(state).includes('canary'));assert.equal(state.messageId,message);}for(const code of ['invalid_input','too_large'])assert.equal(composerResult(initial,form(),{code},next).status,'invalid');});
test('invalid payload or malformed success never clears text or becomes a new message',()=>{for(const result of [{...confirmation,senderId:'bad'}, {...confirmation,createdAt:undefined}])assert.equal(composerResult(initial,form(),result,next).status,'unconfirmed');const f=form();f.set('body','x'.repeat(4001));const state=composerResult(initial,f,{code:'invalid_input'},next);assert.equal(state.status,'invalid');assert.equal(state.body.length,4001);assert.equal(state.messageId,message);});
