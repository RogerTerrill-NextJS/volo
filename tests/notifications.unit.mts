import assert from 'node:assert/strict';
import {test} from 'node:test';
import {listNotifications,type NotificationPorts} from '../lib/notifications/query.ts';
import {notificationReadPolicy} from '../lib/notifications/mutation.ts';
const id=(n:number)=>`22100000-0000-4000-8000-${n.toString().padStart(12,'0')}`;
const viewer=id(1),date='2026-10-26T12:00:00.123456Z',member={userId:viewer,role:'member' as const};
const row=(n=50)=>({id:id(n),recipient_id:viewer,event_type:'request_received',created_at:date,read_at:null});
const ports=(data:unknown=[row()]):NotificationPorts=>({access:async()=>({status:'authorized',member}),rows:async()=>data});
test('list exposes only minimal recipient state, validates every event and never mutates',async()=>{for(const type of ['request_received','request_accepted','message_received']){const r=await listNotifications(null,ports([{...row(),event_type:type,event_key:'private',request_id:id(99)}]));assert.equal(r.status,'authorized');if(r.status==='authorized')assert.deepEqual(r.rows,[{id:id(50),eventType:type,createdAt:date,readAt:null}]);}assert.deepEqual(await listNotifications(null,ports([])),{status:'authorized',rows:[],nextCursor:null});});
test('list uses strict microsecond timestamp and UUID keysets without gaps',async()=>{const r=await listNotifications(null,ports(Array.from({length:21},(_,i)=>row(50-i))));assert.equal(r.status,'authorized');if(r.status!=='authorized')return;assert.equal(r.rows.length,20);assert.equal(r.nextCursor,`${date}~${id(31)}`);let seen;const next=await listNotifications(r.nextCursor,{...ports([row(30)]),rows:async cursor=>{seen=cursor;return [row(30)];}});assert.equal(next.status,'authorized');assert.deepEqual(seen,{createdAt:date,id:id(31)});for(const cursor of ['bad',`${date}~${id(1)},evil`,['bad'],`${date}~${id(31)}~extra`])assert.deepEqual(await listNotifications(cursor,ports()),{status:'invalid'});});
test('foreign records, unsafe chronology and ordering fail closed',async()=>{for(const bad of [{...row(),recipient_id:id(2)},{...row(),event_type:'unknown'},{...row(),created_at:'invalid'},{...row(),read_at:'2026-10-25T00:00:00Z'},{...row(),read_at:'invalid'}])assert.deepEqual(await listNotifications(null,ports([bad])),{status:'unavailable'});for(const data of [[row(),row()],[row(49),row(50)],{},Array.from({length:22},(_,i)=>row(50-i))])assert.deepEqual(await listNotifications(null,ports(data)),{status:'unavailable'});});
test('access is checked before reads and after reads; revocation and account switching discard rows',async()=>{for(const status of ['unauthenticated','forbidden','unavailable'] as const){assert.deepEqual(await listNotifications(null,{...ports(),access:async()=>({status}),rows:async()=>assert.fail('Denied read')}),{status});let n=0;assert.deepEqual(await listNotifications(null,{...ports(),access:async()=>++n===1?{status:'authorized',member}:{status}}),{status});}let n=0;assert.deepEqual(await listNotifications(null,{...ports(),access:async()=>({status:'authorized',member:{...member,userId:++n===1?viewer:id(2)}})}),{status:'forbidden'});assert.deepEqual(await listNotifications(null,{...ports(),rows:async()=>{throw Error('provider-secret');}}),{status:'unavailable'});});
test('mark-read input admits only the notification UUID, never recipient or caller timestamps',()=>{const p=notificationReadPolicy(async()=>({data:null,error:null}));assert.deepEqual(p.parse({notification_id:id(50)}),{ok:true,value:{id:id(50)}});for(const bad of [null,[],{}, {notification_id:'bad'},{notification_id:id(50),recipient_id:viewer},{notification_id:id(50),read_at:date}])assert.deepEqual(p.parse(bad),{ok:false});});
test('mark-read confirms only matching RPC receipts and makes one call on ambiguous failures',async()=>{for(const data of [{code:'read',id:id(50),readAt:date},{code:'notification_unavailable'}]){const r=await notificationReadPolicy(async()=>({data,error:null})).effect(member,{id:id(50)});assert.deepEqual(r,data);}for(const data of [null,[],{code:'read',id:id(2),readAt:date},{code:'read',id:id(50),readAt:'bad'},{code:'unknown'}])assert.deepEqual(await notificationReadPolicy(async()=>({data,error:null})).effect(member,{id:id(50)}),{code:'read_unconfirmed'});let calls=0;assert.deepEqual(await notificationReadPolicy(async()=>{calls++;throw Error('provider-secret');}).effect(member,{id:id(50)}),{code:'read_unconfirmed'});assert.equal(calls,1);assert.deepEqual(await notificationReadPolicy(async()=>({data:null,error:{code:'42501'}})).effect(member,{id:id(50)}),{code:'forbidden'});});
