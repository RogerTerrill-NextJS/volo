import assert from 'node:assert/strict';
import {test} from 'node:test';
import {listConversations,type ListPorts} from '../lib/messages/list-query.ts';
const id=(n:number)=>`20700000-0000-4000-8000-${n.toString().padStart(12,'0')}`;
const viewer=id(1),other=id(2),date='2026-10-24T12:00:00.123456Z';
const row=(n=50)=>({id:id(n),flight_request_id:id(n+100),owner_id:viewer,requester_id:other,created_at:date,closed_at:null});
const ports=(rows:unknown[]=[row()]):ListPorts=>({access:async()=>({status:'authorized',member:{userId:viewer,role:'member'}}),rows:async()=>rows,pilot:async()=>({status:'missing'}),preview:async()=>({body:'<script>alert(1)</script>\n'+'🛩'.repeat(200)}),flight:async()=>null});
test('list keeps permitted history without flight or pilot access and bounds plain text previews',async()=>{const result=await listConversations(null,ports([{...row(),closed_at:date}]));assert.equal(result.status,'authorized');if(result.status!=='authorized')return;assert.equal(result.rows[0].closed,true);assert.equal(result.rows[0].flight,null);assert.equal(result.rows[0].pilotName,null);assert.equal([...result.rows[0].preview!].length,161);assert.ok(result.rows[0].preview!.startsWith('<script>'));});
test('list checks access before reads and discards account changes or revocation',async()=>{for(const status of ['unauthenticated','forbidden','unavailable'] as const){assert.deepEqual(await listConversations(null,{...ports(),access:async()=>({status}),rows:async()=>assert.fail('denied read')}),{status});let n=0;assert.deepEqual(await listConversations(null,{...ports(),access:async()=>++n===1?{status:'authorized',member:{userId:viewer,role:'member'}}:{status}}),{status});}let n=0;assert.deepEqual(await listConversations(null,{...ports(),access:async()=>({status:'authorized',member:{userId:++n===1?viewer:other,role:'member'}})}),{status:'forbidden'});});
test('list rejects foreign bindings, malformed data and re-read races without returning previews',async()=>{for(const bad of [{...row(),owner_id:id(3)}, {...row(),closed_at:'invalid'},{...row(),created_at:'invalid'},{...row(),closed_at:'2026-10-23T00:00:00Z'}])assert.deepEqual(await listConversations(null,ports([bad])),{status:'unavailable'});let n=0;assert.deepEqual(await listConversations(null,{...ports(),rows:async()=>++n===1?[row()]:[],preview:async()=>assert.fail('revoked preview')}),{status:'unavailable'});for(const body of ['', 'x'.repeat(4001),'\u0000'])assert.deepEqual(await listConversations(null,{...ports(),preview:async()=>({body})}),{status:'unavailable'});});
test('stable timestamp and UUID pages use the last visible row and reject unsafe cursors',async()=>{const rows=Array.from({length:21},(_,i)=>row(50-i));const result=await listConversations(null,ports(rows));assert.equal(result.status,'authorized');if(result.status!=='authorized')return;assert.equal(result.rows.length,20);assert.equal(result.nextCursor,`${date}~${id(31)}`);const next=await listConversations(result.nextCursor,ports([row(30)]));assert.equal(next.status,'authorized');for(const cursor of ['bad',`${date}~${id(30)},evil`,['bad'],`${date}~${id(50)}`]){const r=await listConversations(cursor,ports());assert.equal(r.status,typeof cursor==='string'&&cursor.endsWith(id(50))?'unavailable':'invalid');}assert.deepEqual(await listConversations(null,ports([row(),row()])),{status:'unavailable'});});
test('required read errors are unavailable, optional profile failures preserve the list',async()=>{assert.equal((await listConversations(null,{...ports(),pilot:async()=>{throw Error('secret');}})).status,'authorized');for(const method of ['rows','preview','flight'] as const)assert.deepEqual(await listConversations(null,{...ports(),[method]:async()=>{throw Error('secret');}}),{status:'unavailable'});assert.deepEqual(await listConversations(null,ports([])),{status:'authorized',rows:[],nextCursor:null});});
