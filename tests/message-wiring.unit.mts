import assert from 'node:assert/strict';
import {test} from 'node:test';
import {parseMessageInput} from '../lib/messages/input.ts';
import {messageSendPolicy,type SendPorts} from '../lib/messages/send-mutation.ts';
import {getConversationHistory,type HistoryPorts} from '../lib/messages/history-query.ts';
const id=(n:number)=>`20800000-0000-4000-8000-${n.toString().padStart(12,'0')}`;
const viewer=id(1),other=id(2),thread=id(3),request=id(4),date='2026-10-24T12:00:00.123456Z';
const row={id:thread,flight_request_id:request,owner_id:viewer,requester_id:other,created_at:date,closed_at:null};
const raw={conversation_id:thread,message_id:id(5),body:"Pilot's <script>plain text</script> 🛩"};
const input={conversationId:thread,messageId:id(5),body:raw.body},member={userId:viewer,role:'member' as const};
const confirmation={id:id(5),conversationId:thread,senderId:viewer,createdAt:date};
const sendPorts=():SendPorts=>({thread:async()=>row,send:async value=>{assert.deepEqual(value,input);return {data:confirmation,error:null};}});
const message=(n:number)=>({id:id(n),conversation_id:thread,sender_id:other,body:'Message '+n,created_at:date});
const historyPorts=(rows:unknown[]=[message(10)]):HistoryPorts=>({access:async()=>({status:'authorized',member}),thread:async()=>row,messages:async()=>rows,connection:async()=>({status:'missing'})});
test('send input enforces exact fields, UUIDs and 1–4000 nonblank Unicode characters with consistent form line endings',()=>{assert.deepEqual(parseMessageInput(raw),input);assert.equal(parseMessageInput({...raw,body:'a\r\nb\rc'})?.body,'a\nb\nc');assert.equal(parseMessageInput({...raw,body:'🛩'.repeat(4000)})?.body.length,8000);for(const value of [null,{},[],{...raw,sender_id:other},{...raw,body:''},{...raw,body:' \r\n\t'},{...raw,body:'x'.repeat(4001)},{...raw,body:'\ud800'},{...raw,body:'\u0000'},{...raw,conversation_id:'bad'}])assert.equal(parseMessageInput(value),null);});
test('send binds actual session participant and confirms only matching metadata',async()=>{assert.notEqual(messageSendPolicy(sendPorts()).requireCompleteProfile,true);assert.deepEqual(await messageSendPolicy(sendPorts()).effect(member,input),{code:'sent',...confirmation});for(const data of [null,[],{...confirmation,id:other},{...confirmation,senderId:other},{...confirmation,conversationId:other},{...confirmation,createdAt:'invalid'}])assert.deepEqual(await messageSendPolicy({...sendPorts(),send:async()=>({data,error:null})}).effect(member,input),{code:'send_unconfirmed'});for(const bad of [null,{...row,owner_id:id(90)},{...row,id:other},{...row,closed_at:date}])assert.deepEqual(await messageSendPolicy({...sendPorts(),thread:async()=>bad,send:async()=>assert.fail('No unauthorized send')}).effect(member,input),{code:'conversation_unavailable'});});
test('send failures have safe definitive or ambiguous outcomes and never retry',async()=>{for(const [dbCode,code] of [['42501','forbidden'],['22023','invalid_input'],['XX000','send_unconfirmed']]){let calls=0;assert.deepEqual(await messageSendPolicy({...sendPorts(),send:async()=>{calls++;return {data:null,error:{code:dbCode}};}}).effect(member,input),{code});assert.equal(calls,1);}assert.deepEqual(await messageSendPolicy({...sendPorts(),send:async()=>{throw Error('provider-secret');}}).effect(member,input),{code:'send_unconfirmed'});assert.deepEqual(await messageSendPolicy({...sendPorts(),thread:async()=>{throw Error('provider-secret');}}).effect(member,input),{code:'unavailable'});});
test('history preserves closed/disabled-counterpart history independently of writable authority',async()=>{for(const closed of [false,true]){const result=await getConversationHistory(thread,null,{...historyPorts(),thread:async()=>({...row,closed_at:closed?date:null})});assert.equal(result.status,'authorized');if(result.status!=='authorized')return;assert.equal(result.sendStatus,'closed');assert.deepEqual(result.messages.map(m=>m.id),[id(10)]);assert.equal(result.conversation.counterpartId,other);}const unavailable=await getConversationHistory(thread,null,{...historyPorts(),connection:async()=>({status:'unavailable'})});assert.equal(unavailable.status,'authorized');if(unavailable.status==='authorized')assert.equal(unavailable.sendStatus,'unavailable');});
test('history uses strict timestamp/id keysets, limits and chronological pages',async()=>{const descending=Array.from({length:31},(_,i)=>message(100-i)),result=await getConversationHistory(thread,null,historyPorts(descending));assert.equal(result.status,'authorized');if(result.status!=='authorized')return;assert.equal(result.messages.length,30);assert.equal(result.messages[0].id,id(71));assert.equal(result.messages.at(-1)?.id,id(100));assert.equal(result.olderCursor,`${date}~${id(71)}`);assert.equal((await getConversationHistory(thread,result.olderCursor,historyPorts([message(70)]))).status,'authorized');for(const after of ['bad',`${date}~${id(71)},evil`,['bad']])assert.deepEqual(await getConversationHistory(thread,after,historyPorts()),{status:'invalid'});for(const rows of [[message(10),message(10)],[{...message(10),sender_id:id(99)}],[{...message(10),conversation_id:other}],[{...message(10),body:'x'.repeat(4001)}]])assert.deepEqual(await getConversationHistory(thread,null,historyPorts(rows)),{status:'unavailable'});});
test('history gates before reads and discards mid-read revoked, foreign or changed session data',async()=>{for(const status of ['forbidden','unauthenticated','unavailable'] as const){assert.deepEqual(await getConversationHistory(thread,null,{...historyPorts(),access:async()=>({status}),thread:async()=>assert.fail('No denied read')}),{status});let n=0;assert.deepEqual(await getConversationHistory(thread,null,{...historyPorts(),access:async()=>++n===1?{status:'authorized',member}:{status}}),{status});}assert.deepEqual(await getConversationHistory(thread,null,{...historyPorts(),thread:async()=>null}),{status:'missing'});let n=0;assert.deepEqual(await getConversationHistory(thread,null,{...historyPorts(),thread:async()=>++n===1?row:null}),{status:'missing'});n=0;assert.deepEqual(await getConversationHistory(thread,null,{...historyPorts(),access:async()=>({status:'authorized',member:{...member,userId:++n===1?viewer:other}})}),{status:'forbidden'});});
test('history accepts persisted database-valid text even when JavaScript trim considers it blank',async()=>{const result=await getConversationHistory(thread,null,historyPorts([{...message(10),body:'\uFEFF'}]));assert.equal(result.status,'authorized');if(result.status==='authorized')assert.equal(result.messages[0].body,'\uFEFF');});
test('deleted-pilot lookup cannot extend a revoked history approval',async()=>{
 let revoked=false;
 assert.deepEqual(await getConversationHistory(thread,null,{...historyPorts(),deleted:async()=>{revoked=true;return true;},access:async()=>revoked?{status:'forbidden'}:{status:'authorized',member}}),{status:'forbidden'});
});
