import assert from 'node:assert/strict';
import {test} from 'node:test';
import {watchConversation,type LiveClient} from '../lib/messages/realtime.ts';
const thread='21000000-0000-4000-8000-000000000001',viewer='21000000-0000-4000-8000-000000000002',other='21000000-0000-4000-8000-000000000003';
const message={eventType:'INSERT',new:{id:other,conversation_id:thread}};
function fixture(){let insert:(value:unknown)=>void=()=>{},status:(value:string)=>void=()=>{},auth:(event:string,session:unknown)=>void=()=>{};const calls={channels:0,removed:0,unsubscribed:0,refreshed:0,identities:0,states:[] as string[],filter:null as unknown,config:null as unknown},timers=new Map<number,()=>void>();let tick=0;
 const channel={on(type:string,filter:unknown,handler:typeof insert){assert.equal(type,'postgres_changes');calls.filter=filter;insert=handler;return channel;},subscribe(handler:typeof status){status=handler;return channel;}};
 const client={auth:{getSession:async()=>({data:{session:{user:{id:viewer}}},error:null}),onAuthStateChange(handler:typeof auth){auth=handler;return {data:{subscription:{unsubscribe(){calls.unsubscribed++;}}}};}},channel(name:string,config:unknown){assert.equal(name,'conversation:'+thread);calls.channels++;calls.config=config;return channel;},removeChannel:async()=>{calls.removed++;return 'ok';}} as unknown as LiveClient;
 const start=()=>watchConversation({client,conversationId:thread,viewerId:viewer,refresh:()=>calls.refreshed++,identityLost:()=>calls.identities++,state:value=>calls.states.push(value),schedule:fn=>{timers.set(++tick,fn);return tick;},cancel:id=>{timers.delete(id as number);}});
 const flush=()=>{for(const [id,fn] of timers){timers.delete(id);fn();}};
 return {client,calls,start,flush,insert:(value:unknown)=>insert(value),status:(value:string)=>status(value),auth:(id:string|null,event='SIGNED_IN')=>auth(event,id?{user:{id}}:null)};
}
const settled=async()=>{await Promise.resolve();await Promise.resolve();};
test('one confirmed INSERT subscription filters the exact authorized conversation and coalesces catchup',async()=>{const f=fixture(),watch=f.start();await settled();assert.equal(f.calls.channels,1);assert.deepEqual(f.calls.config,{config:{postgres_changes_options:{wait:true,timeout:15000}}});assert.deepEqual(f.calls.filter,{event:'INSERT',schema:'public',table:'messages',filter:'conversation_id=eq.'+thread});f.status('SUBSCRIBED');f.insert(message);f.insert(message);f.flush();assert.equal(f.calls.refreshed,1);assert.equal(f.calls.states.at(-1),'live');await watch.close();assert.equal(f.calls.removed,1);assert.equal(f.calls.unsubscribed,1);});
test('ignores unrelated/malformed events and never retains or returns their body',async()=>{const f=fixture(),watch=f.start();await settled();for(const payload of [null,{}, {...message,eventType:'DELETE'},{...message,new:{id:other,conversation_id:other,body:'private-canary'}},{...message,new:{id:'bad',conversation_id:thread}}])f.insert(payload);f.flush();assert.equal(f.calls.refreshed,0);assert.ok(!JSON.stringify(f.calls).includes('private-canary'));await watch.close();});
test('channel error refreshes once and SDK rejoin catches up without another subscription',async()=>{const f=fixture(),watch=f.start();await settled();f.status('CHANNEL_ERROR');f.status('CHANNEL_ERROR');f.flush();assert.equal(f.calls.refreshed,1);assert.equal(f.calls.states.at(-1),'reconnecting');f.status('SUBSCRIBED');f.flush();assert.equal(f.calls.refreshed,2);assert.equal(f.calls.channels,1);watch.resume();f.flush();assert.equal(f.calls.refreshed,3);await watch.close();});
test('navigation cancels queued refreshes and ignores late stream/session callbacks',async()=>{const f=fixture(),watch=f.start();await settled();f.insert(message);await watch.close();f.status('SUBSCRIBED');f.insert(message);f.auth(other);f.flush();assert.equal(f.calls.refreshed,0);assert.equal(f.calls.removed,1);const early=fixture(),stopped=early.start();await stopped.close();await settled();assert.equal(early.calls.channels,0);});
test('identity change removes only the owned channel and rechecks the protected page',async()=>{const f=fixture(),watch=f.start();await settled();f.auth(other);await settled();f.flush();assert.equal(f.calls.removed,1);assert.equal(f.calls.unsubscribed,1);assert.equal(f.calls.refreshed,1);assert.equal(f.calls.identities,1);f.insert(message);f.flush();assert.equal(f.calls.refreshed,1);await watch.close();assert.equal(f.calls.removed,1);});
test('a transient initial session failure can recover on resume without duplicate channels',async()=>{const f=fixture();let reads=0;const read=f.client.auth.getSession.bind(f.client.auth);f.client.auth.getSession=async()=>++reads===1?{data:{session:null},error:Error('fixture outage')} as Awaited<ReturnType<typeof read>>:read();const watch=f.start();await settled();assert.equal(f.calls.channels,0);assert.equal(f.calls.states.at(-1),'unavailable');f.auth(null,'INITIAL_SESSION');assert.equal(f.calls.removed,0);assert.equal(f.calls.unsubscribed,0);assert.equal(f.calls.identities,0);watch.resume();await settled();assert.equal(f.calls.channels,1);watch.resume();await settled();assert.equal(f.calls.channels,1);await watch.close();});
