# Copy to .env.local. Use the matching project's publishable key, never a secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Production and Netlify Deploy Previews currently share this hosted project.
# Separate staging is deferred. References are identifiers, not credentials.
SUPABASE_PRODUCTION_PROJECT_REF=macrktxywcqauxqkbnqb

# Used by the CLI only. Configure locally or in protected CI secrets when needed.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
