# Copy to .env.local and fill both required fields before npm run dev/build.
# Browser-public, embedded at build time. Use the matching project's
# sb_publishable_ key, never sb_secret_ or a legacy service_role JWT.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required locally before invoking protected mutations; exact scheme/host/port.
# Builds pin this non-secret origin. Netlify uses its own context metadata.
VOLO_MUTATION_ORIGIN=http://localhost:3000

# Production and Netlify Deploy Previews currently share this hosted project.
# No separate staging environment is used. References are identifiers, not credentials.
# Optional operator reference; not read by the app and does not select its DB.
# NEXT_PUBLIC_SUPABASE_URL above selects the app's Supabase project.
SUPABASE_PRODUCTION_PROJECT_REF=macrktxywcqauxqkbnqb

# Used by the CLI only; server-only secrets. Leave blank for ordinary app work.
# Configure locally or in protected CI secrets when needed, never in Netlify.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional until invitation confirmation is separately activated. Server-only.
# JSON: {"active":"key-id","keys":{"key-id":"<base64-32-byte-key>"}}
# Do not use placeholders as real keys or add NEXT_PUBLIC_ to this variable.
VOLO_CONFIRMATION_KEYS=
